<h1 style="text-align:center; margin-bottom: 20px;">List of Authors</h1>

{% if tabAuthors is empty %}
    <h2 style="color: red; text-align: center;">No authors found</h2>
{% else %}
    <table border="1" cellspacing="0" cellpadding="10" style="margin: auto; border-collapse: collapse; width: 80%; text-align: center;">
        <thead style="background-color: #f2f2f2;">
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Email</th>
                <th>Number of Books</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for x in tabAuthors %}
                <tr>
                    <td>{{ x.id }}</td>
                    <td>{{ x.username }}</td>
                    <td>{{ x.email }}</td>
                    <td>{{ x.nbbook }}</td>
                    <td>
                        {# <a href="{{ path('update_author', {'id': x.id}) }}"  #}
                           {# style="background-color:#4CAF50; color:white; padding:6px 10px; text-decoration:none; border-radius:5px;"> #}
                           {# Update #}
                        {# </a> #}
                        <a href="{{ path('removeauthor', {'id': x.id}) }}"
                           style="background-color:blue; color:white; padding:6px 10px; text-decoration:none; border-radius:5px;"
                           onclick="return confirm('Are you sure you want to delete {{ x.username }}?');">
                           Delete
                        </a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}