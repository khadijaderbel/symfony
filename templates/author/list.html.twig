<p1>nombre de Authors = {{nbrAuthors}}</p1>
<p1>nom de Author = {{firstname}}</p1>
{% set sum = 0%}
<h1> Tab Authors</h1>
{% if tabAuthors is empty %}:
<h4> tab empty</h4>
{% else %}
<table border="1">
   <tr>
      <td>Id</td>
      <td>Username</td>
      <td>Email</td>
      <td>Nbr of Books</td>
            <td> Details</td>

   </tr>
   {% for x in tabAuthors %}
      <tr>
      <td>{{ x.id }}</td>
      <td>{{ x.username |upper }}</td>sy
      <td>{{ x.email }}</td>
      <td>{{ x.getNbBooks() }}</td>
      <td><img src="{{x.picture}}" HEIGHT ="40"/></td>
            <td><a href="{{path('show_author',{id:x.id})}}">show </a></td>
{% set sum = sum + x.nb_books %}
      </tr>
   {% endfor %}
</table>
{% endif %}
sum={{sum}}
<h4>Nbr Of  Authors = {{ tabAuthors|length }}</h4>
<a href="{{path('app_author')}}">Index action Author </a>